# Copy to .env and fill in. Never commit the real .env file.

# MongoDB connection string (docker-compose default shown)
MONGODB_URI=mongodb://localhost:27017/dnd-ai-sim

# Anthropic API key used by the AI Dungeon Master service
ANTHROPIC_API_KEY=

# Model used for AI DM narration/rulings
AI_DM_MODEL=claude-sonnet-5

# Secret used to sign player/admin session JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Backend HTTP + WebSocket port
SERVER_PORT=4000

# Origin the server allows for CORS / socket connections (the web dev server)
WEB_ORIGIN=http://localhost:5173
