# Copy to .env.local (used by `vercel dev` and the seed script) and fill in.
# Also set the same values in your Vercel project's Environment Variables for
# production/preview deploys. Never commit the real .env.local file.

# --- Supabase (Project Settings -> API) ---
# Server-side (serverless functions, service-role key -- keeps this SECRET, bypasses RLS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (browser, anon/public key -- fine to expose, RLS restricts it to read-only)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
AI_DM_MODEL=claude-sonnet-5

# --- Auth ---
# Secret used to sign player/admin session JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
